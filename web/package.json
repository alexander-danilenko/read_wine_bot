{
  "name": "read-wine-bot-web",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "build": "npm run gen && tsc --noEmit && vite build && touch ../internal/webapp/dist/.gitkeep",
    "dev": "vite"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}

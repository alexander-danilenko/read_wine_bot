{
  "components": {
    "schemas": {
      "APIError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "What went wrong; the app shows its own text for it",
            "enum": [
              "unauthorized",
              "internal",
              "invalid",
              "not_found",
              "not_yours",
              "finished",
              "not_admin",
              "bot_no_rights",
              "post_gone",
              "exists",
              "taken",
              "invalid_post_link",
              "invalid_end",
              "end_in_past",
              "invalid_winners",
              "invalid_button_text",
              "other_channel",
              "due",
              "stale",
              "failed"
            ],
            "type": "string"
          },
          "detail": {
            "description": "Details for developers, not for users",
            "type": "string"
          },
          "errors": {
            "description": "Schema validation errors",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "field": {
            "description": "The request field the error concerns, when there is one",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "HTTP status text",
            "type": "string"
          }
        },
        "required": [
          "status",
          "title",
          "code"
        ],
        "type": "object"
      },
      "CreateInputBody": {
        "additionalProperties": false,
        "properties": {
          "button_text": {
            "description": "Label of the join button, at most 64 characters",
            "type": "string"
          },
          "ends_at": {
            "description": "End time in Kyiv, YYYY-MM-DDTHH:MM",
            "type": "string"
          },
          "post_link": {
            "description": "t.me link to the channel post",
            "type": "string"
          },
          "winners": {
            "description": "Number of winners to draw, 1 to 98",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "post_link",
          "ends_at",
          "winners",
          "button_text"
        ],
        "type": "object"
      },
      "EditInputBody": {
        "additionalProperties": false,
        "properties": {
          "button_text": {
            "description": "New label of the join button",
            "type": "string"
          },
          "ends_at": {
            "description": "New end time in Kyiv, YYYY-MM-DDTHH:MM",
            "type": "string"
          },
          "winners": {
            "description": "New number of winners, 1 to 98",
            "format": "int64",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "FinishedOutputBody": {
        "additionalProperties": false,
        "properties": {
          "giveaways": {
            "description": "The caller's finished giveaways, latest draw first",
            "items": {
              "$ref": "#/components/schemas/GiveawayBody"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "more": {
            "description": "Whether more giveaways follow",
            "type": "boolean"
          }
        },
        "required": [
          "giveaways",
          "more"
        ],
        "type": "object"
      },
      "GiveawayBody": {
        "additionalProperties": false,
        "properties": {
          "button_text": {
            "description": "Label of the join button",
            "type": "string"
          },
          "chat_id": {
            "description": "Telegram ID of the channel",
            "format": "int64",
            "type": "integer"
          },
          "ends_at": {
            "description": "Kyiv end time, YYYY-MM-DDTHH:MM",
            "type": "string"
          },
          "id": {
            "description": "Giveaway ID",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "message_id": {
            "description": "Telegram ID of the post",
            "format": "int64",
            "type": "integer"
          },
          "participants": {
            "description": "Number of users who joined",
            "format": "int64",
            "type": "integer"
          },
          "post_link": {
            "description": "Link to the channel post",
            "type": "string"
          },
          "status": {
            "description": "Where the giveaway is",
            "enum": [
              "active",
              "due",
              "cancelled",
              "review",
              "finished"
            ],
            "type": "string"
          },
          "winners": {
            "description": "Number of winners to draw",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "post_link",
          "chat_id",
          "message_id",
          "ends_at",
          "winners",
          "button_text",
          "status",
          "participants"
        ],
        "type": "object"
      },
      "ListOutputBody": {
        "additionalProperties": false,
        "properties": {
          "giveaways": {
            "description": "The caller's running and cancelled giveaways, soonest end first",
            "items": {
              "$ref": "#/components/schemas/GiveawayBody"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "review": {
            "description": "Giveaways whose results wait for review in channels the caller is an admin of",
            "items": {
              "$ref": "#/components/schemas/GiveawayBody"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "giveaways",
          "review"
        ],
        "type": "object"
      },
      "MeOutputBody": {
        "additionalProperties": false,
        "properties": {
          "first_name": {
            "description": "The user's first name",
            "type": "string"
          },
          "language": {
            "description": "The language to show the app in",
            "enum": [
              "en",
              "uk"
            ],
            "type": "string"
          }
        },
        "required": [
          "language",
          "first_name"
        ],
        "type": "object"
      },
      "MoveInputBody": {
        "additionalProperties": false,
        "properties": {
          "post_link": {
            "description": "t.me link to another post of the same channel",
            "type": "string"
          }
        },
        "required": [
          "post_link"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "telegramInitData": {
        "description": "tma followed by Telegram.WebApp.initData",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "read_wine_bot Mini App API",
    "version": "spec"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/giveaways": {
      "get": {
        "operationId": "listGiveaways",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "The caller's running and cancelled giveaways, and results waiting for review"
      },
      "post": {
        "operationId": "createGiveaway",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GiveawayBody"
                }
              }
            },
            "description": "Created"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Create a giveaway and put its join button on the post"
      }
    },
    "/api/giveaways/finished": {
      "get": {
        "operationId": "listFinishedGiveaways",
        "parameters": [
          {
            "description": "How many giveaways to skip",
            "explode": false,
            "in": "query",
            "name": "offset",
            "schema": {
              "default": 0,
              "description": "How many giveaways to skip",
              "format": "int64",
              "maximum": 100000,
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "Page size",
            "explode": false,
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 25,
              "description": "Page size",
              "format": "int64",
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FinishedOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "The caller's finished giveaways, page by page"
      }
    },
    "/api/giveaways/{id}": {
      "get": {
        "operationId": "getGiveaway",
        "parameters": [
          {
            "description": "Giveaway ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "Giveaway ID",
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GiveawayBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "One of the caller's giveaways"
      },
      "patch": {
        "operationId": "editGiveaway",
        "parameters": [
          {
            "description": "Giveaway ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "Giveaway ID",
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EditInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GiveawayBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Change the end time, winner count or button text"
      }
    },
    "/api/giveaways/{id}/cancel": {
      "post": {
        "operationId": "cancelGiveaway",
        "parameters": [
          {
            "description": "Giveaway ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "Giveaway ID",
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GiveawayBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Take the giveaway off its post"
      }
    },
    "/api/giveaways/{id}/finish-now": {
      "post": {
        "operationId": "finishGiveawayNow",
        "parameters": [
          {
            "description": "Giveaway ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "Giveaway ID",
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GiveawayBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "End the giveaway now; the draw follows within a minute"
      }
    },
    "/api/giveaways/{id}/move": {
      "post": {
        "operationId": "moveGiveaway",
        "parameters": [
          {
            "description": "Giveaway ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "Giveaway ID",
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MoveInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GiveawayBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Move the giveaway to another post of its channel"
      }
    },
    "/api/giveaways/{id}/restore": {
      "post": {
        "operationId": "restoreGiveaway",
        "parameters": [
          {
            "description": "Giveaway ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "Giveaway ID",
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GiveawayBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Put a cancelled giveaway back on its post"
      }
    },
    "/api/me": {
      "get": {
        "operationId": "getMe",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Who is using the app and in which language"
      }
    }
  },
  "security": [
    {
      "telegramInitData": []
    }
  ]
}

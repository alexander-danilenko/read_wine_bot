{
  "components": {
    "schemas": {
      "APIError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "What went wrong; the app shows its own text for it",
            "enum": [
              "unauthorized",
              "internal",
              "invalid",
              "not_found",
              "not_yours",
              "finished",
              "not_admin",
              "bot_no_rights",
              "post_gone",
              "exists",
              "taken",
              "invalid_post_link",
              "invalid_end",
              "end_in_past",
              "invalid_winners",
              "invalid_button_text",
              "other_channel",
              "due",
              "stale",
              "failed",
              "review_closed",
              "published_partly"
            ],
            "type": "string"
          },
          "detail": {
            "description": "Details for developers, not for users",
            "type": "string"
          },
          "errors": {
            "description": "Schema validation errors",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": "array"
          },
          "field": {
            "description": "The request field the error concerns, when there is one",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "HTTP status text",
            "type": "string"
          }
        },
        "required": [
          "status",
          "title",
          "code"
        ],
        "type": "object"
      },
      "ArchiveOutputBody": {
        "additionalProperties": false,
        "properties": {
          "channels": {
            "description": "The channels of these giveaways, each once",
            "items": {
              "$ref": "#/components/schemas/ListChannelBody"
            },
            "type": "array"
          },
          "giveaways": {
            "description": "One page of the caller's finished and cancelled giveaways, the latest to end first",
            "items": {
              "$ref": "#/components/schemas/GiveawayBody"
            },
            "type": "array"
          },
          "total": {
            "description": "How many finished and cancelled giveaways the caller has",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "giveaways",
          "total",
          "channels"
        ],
        "type": "object"
      },
      "ChannelBody": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "Telegram ID of the channel",
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "Channel title",
            "type": "string"
          },
          "username": {
            "description": "Public username without @, or empty",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "username"
        ],
        "type": "object"
      },
      "CloseReviewInputBody": {
        "additionalProperties": false,
        "properties": {
          "rerolled": {
            "description": "The rerolled count the review showed",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "rerolled"
        ],
        "type": "object"
      },
      "CreateInputBody": {
        "additionalProperties": false,
        "properties": {
          "button_text": {
            "description": "Label of the join button, at most 64 characters",
            "type": "string"
          },
          "ends_at": {
            "description": "End time in Kyiv, YYYY-MM-DDTHH:MM",
            "type": "string"
          },
          "post_link": {
            "description": "t.me link to the channel post",
            "type": "string"
          },
          "winners": {
            "description": "Number of winners to draw, 1 to 98",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "post_link",
          "ends_at",
          "winners",
          "button_text"
        ],
        "type": "object"
      },
      "EditInputBody": {
        "additionalProperties": false,
        "properties": {
          "button_text": {
            "description": "New label of the join button",
            "type": "string"
          },
          "ends_at": {
            "description": "New end time in Kyiv, YYYY-MM-DDTHH:MM",
            "type": "string"
          },
          "winners": {
            "description": "New number of winners, 1 to 98",
            "format": "int64",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "GiveawayBody": {
        "additionalProperties": false,
        "properties": {
          "button_text": {
            "description": "Label of the join button",
            "type": "string"
          },
          "chat_id": {
            "description": "Telegram ID of the channel",
            "format": "int64",
            "type": "integer"
          },
          "ends_at": {
            "description": "Kyiv end time, YYYY-MM-DDTHH:MM",
            "type": "string"
          },
          "id": {
            "description": "Giveaway ID",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "message_id": {
            "description": "Telegram ID of the post",
            "format": "int64",
            "type": "integer"
          },
          "participants": {
            "description": "Number of users who joined",
            "format": "int64",
            "type": "integer"
          },
          "post_link": {
            "description": "Link to the channel post",
            "type": "string"
          },
          "status": {
            "description": "Where the giveaway is",
            "enum": [
              "active",
              "due",
              "cancelled",
              "review",
              "finished"
            ],
            "type": "string"
          },
          "winners": {
            "description": "Number of winners to draw",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "post_link",
          "chat_id",
          "message_id",
          "ends_at",
          "winners",
          "button_text",
          "status",
          "participants"
        ],
        "type": "object"
      },
      "GiveawayDetailsOutputBody": {
        "additionalProperties": false,
        "properties": {
          "channel": {
            "$ref": "#/components/schemas/ListChannelBody",
            "description": "Its channel, read live from Telegram"
          },
          "giveaway": {
            "$ref": "#/components/schemas/GiveawayBody",
            "description": "The giveaway"
          }
        },
        "required": [
          "giveaway",
          "channel"
        ],
        "type": "object"
      },
      "ListChannelBody": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "Telegram ID of the channel",
            "format": "int64",
            "type": "integer"
          },
          "photo": {
            "description": "URL of the small channel photo, empty for none",
            "type": "string"
          },
          "title": {
            "description": "Channel title, empty if Telegram cannot give it",
            "type": "string"
          },
          "username": {
            "description": "Public username without @, empty for a private channel",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "username",
          "photo"
        ],
        "type": "object"
      },
      "ListOutputBody": {
        "additionalProperties": false,
        "properties": {
          "channels": {
            "description": "The channels of these giveaways, each once",
            "items": {
              "$ref": "#/components/schemas/ListChannelBody"
            },
            "type": "array"
          },
          "giveaways": {
            "description": "One page of the caller's running giveaways, newest first",
            "items": {
              "$ref": "#/components/schemas/GiveawayBody"
            },
            "type": "array"
          },
          "review": {
            "description": "Giveaways whose results wait for review in channels the caller is an admin of",
            "items": {
              "$ref": "#/components/schemas/GiveawayBody"
            },
            "type": "array"
          },
          "total": {
            "description": "How many running giveaways the caller has",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "giveaways",
          "total",
          "review",
          "channels"
        ],
        "type": "object"
      },
      "MeBody": {
        "additionalProperties": false,
        "properties": {
          "add_link": {
            "description": "Adds the bot to a channel with giveaway rights",
            "type": "string"
          },
          "first_name": {
            "description": "The user's first name",
            "type": "string"
          },
          "language": {
            "description": "The language to show the app in",
            "enum": [
              "en",
              "uk"
            ],
            "type": "string"
          },
          "partner_link": {
            "description": "Adds the bot to a partner channel",
            "type": "string"
          }
        },
        "required": [
          "language",
          "first_name",
          "add_link",
          "partner_link"
        ],
        "type": "object"
      },
      "MoveInputBody": {
        "additionalProperties": false,
        "properties": {
          "post_link": {
            "description": "t.me link to another post of the same channel",
            "type": "string"
          }
        },
        "required": [
          "post_link"
        ],
        "type": "object"
      },
      "MyChannelsOutputBody": {
        "additionalProperties": false,
        "properties": {
          "channels": {
            "description": "Channels where both the bot and the caller are admins",
            "items": {
              "$ref": "#/components/schemas/ListChannelBody"
            },
            "type": "array"
          }
        },
        "required": [
          "channels"
        ],
        "type": "object"
      },
      "RerollInputBody": {
        "additionalProperties": false,
        "properties": {
          "winner_id": {
            "description": "Telegram user ID of the winner to replace",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "winner_id"
        ],
        "type": "object"
      },
      "ReviewOutputBody": {
        "additionalProperties": false,
        "properties": {
          "channels": {
            "description": "Channels whose subscriptions the review shows",
            "items": {
              "$ref": "#/components/schemas/ChannelBody"
            },
            "type": "array"
          },
          "giveaway": {
            "$ref": "#/components/schemas/GiveawayBody",
            "description": "The drawn giveaway"
          },
          "rerolled": {
            "description": "Rerolled-out count; send it back to publish or skip",
            "format": "int64",
            "type": "integer"
          },
          "winners": {
            "description": "Current winners in place order",
            "items": {
              "$ref": "#/components/schemas/WinnerBody"
            },
            "type": "array"
          }
        },
        "required": [
          "giveaway",
          "winners",
          "channels",
          "rerolled"
        ],
        "type": "object"
      },
      "SetLanguageInputBody": {
        "additionalProperties": false,
        "properties": {
          "language": {
            "description": "The language to save",
            "enum": [
              "en",
              "uk"
            ],
            "type": "string"
          }
        },
        "required": [
          "language"
        ],
        "type": "object"
      },
      "WinnerBody": {
        "additionalProperties": false,
        "properties": {
          "first_name": {
            "description": "First name",
            "type": "string"
          },
          "last_name": {
            "description": "Last name, or empty",
            "type": "string"
          },
          "place": {
            "description": "Place from 1",
            "format": "int64",
            "type": "integer"
          },
          "subscriptions": {
            "description": "Subscription to each channel of the review, in order",
            "items": {
              "enum": [
                "subscribed",
                "not_subscribed",
                "unknown"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "user_id": {
            "description": "Telegram user ID",
            "format": "int64",
            "type": "integer"
          },
          "username": {
            "description": "Username without @, or empty",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "first_name",
          "last_name",
          "username",
          "place",
          "subscriptions"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "telegramInitData": {
        "description": "tma followed by Telegram.WebApp.initData",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "read_wine_bot Mini App API",
    "version": "spec"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/channels": {
      "get": {
        "operationId": "listMyChannels",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MyChannelsOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Channels where both the bot and the caller are admins"
      }
    },
    "/api/giveaways": {
      "get": {
        "operationId": "listGiveaways",
        "parameters": [
          {
            "description": "How many giveaways to skip",
            "explode": false,
            "in": "query",
            "name": "offset",
            "schema": {
              "default": 0,
              "description": "How many giveaways to skip",
              "format": "int64",
              "maximum": 100000,
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "Page size",
            "explode": false,
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 10,
              "description": "Page size",
              "format": "int64",
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "The caller's running giveaways page by page, and results waiting for review"
      },
      "post": {
        "operationId": "createGiveaway",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GiveawayBody"
                }
              }
            },
            "description": "Created"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Create a giveaway and put its join button on the post"
      }
    },
    "/api/giveaways/finished": {
      "get": {
        "operationId": "listFinishedGiveaways",
        "parameters": [
          {
            "description": "How many giveaways to skip",
            "explode": false,
            "in": "query",
            "name": "offset",
            "schema": {
              "default": 0,
              "description": "How many giveaways to skip",
              "format": "int64",
              "maximum": 100000,
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "Page size",
            "explode": false,
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 10,
              "description": "Page size",
              "format": "int64",
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArchiveOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "The caller's finished and cancelled giveaways, page by page"
      }
    },
    "/api/giveaways/{id}": {
      "get": {
        "operationId": "getGiveaway",
        "parameters": [
          {
            "description": "Giveaway ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "Giveaway ID",
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GiveawayDetailsOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "One of the caller's giveaways"
      },
      "patch": {
        "operationId": "editGiveaway",
        "parameters": [
          {
            "description": "Giveaway ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "Giveaway ID",
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EditInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GiveawayBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Change the end time, winner count or button text"
      }
    },
    "/api/giveaways/{id}/cancel": {
      "post": {
        "operationId": "cancelGiveaway",
        "parameters": [
          {
            "description": "Giveaway ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "Giveaway ID",
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GiveawayBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Take the giveaway off its post"
      }
    },
    "/api/giveaways/{id}/finish-now": {
      "post": {
        "operationId": "finishGiveawayNow",
        "parameters": [
          {
            "description": "Giveaway ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "Giveaway ID",
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GiveawayBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "End the giveaway now; the draw follows within a minute"
      }
    },
    "/api/giveaways/{id}/move": {
      "post": {
        "operationId": "moveGiveaway",
        "parameters": [
          {
            "description": "Giveaway ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "Giveaway ID",
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MoveInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GiveawayBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Move the giveaway to another post of its channel"
      }
    },
    "/api/giveaways/{id}/restore": {
      "post": {
        "operationId": "restoreGiveaway",
        "parameters": [
          {
            "description": "Giveaway ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "Giveaway ID",
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GiveawayBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Put a cancelled giveaway back on its post"
      }
    },
    "/api/me": {
      "get": {
        "operationId": "getMe",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Who is using the app and in which language"
      }
    },
    "/api/me/language": {
      "put": {
        "operationId": "setLanguage",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetLanguageInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {

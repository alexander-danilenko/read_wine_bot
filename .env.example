# Telegram bot token from @BotFather
# Keep it secret! Anyone with the token controls the bot.
TELEGRAM_BOT_TOKEN=

# PostgreSQL connection URL: postgres://user:password@host:port/database
# The bot creates and updates its tables itself, so an empty database is enough.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/read_wine_bot?sslmode=disable

# Public https:// URL of the Mini App, the same one registered with @BotFather.
# The HTTPS proxy in front of the bot forwards it to LISTEN_ADDR.
APP_URL=

# Where the Mini App and its API listen (optional, default :8080).
LISTEN_ADDR=:8080

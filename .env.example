TELEGRAM_BOT_TOKEN=

# Database: sqlite or postgres.
DB_DRIVER=sqlite
# sqlite: a file path, without ?; the bot adds the pragmas it needs. In Docker, put it on a mounted volume.
# postgres: a connection string, e.g. postgres://user:password@host:5432/read_wine_bot?sslmode=disable
DB_DSN=read_wine_bot.db

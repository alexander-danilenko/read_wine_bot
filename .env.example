TELEGRAM_BOT_TOKEN=

# Local PostgreSQL started by `docker compose up -d`. These values apply only when the data
# volume is first created; to change them later, run `docker compose down -v` (deletes the data).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=read_wine_bot

# PostgreSQL connection URL. For the compose database it repeats the three POSTGRES_ values.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/read_wine_bot?sslmode=disable

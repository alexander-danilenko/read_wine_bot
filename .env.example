TELEGRAM_BOT_TOKEN=

# Local PostgreSQL started by `docker compose up -d`. These values apply only when the data
# volume is first created; to change them later, run `docker compose down -v` (deletes the data).
# Password of the "postgres" superuser.
POSTGRES_PASSWORD=postgres
DB_NAME=read_wine_bot
DB_USER=read_wine_bot
DB_PASSWORD=read_wine_bot

# PostgreSQL connection URL. For the compose database it repeats DB_USER, DB_PASSWORD and DB_NAME.
DATABASE_URL=postgres://read_wine_bot:read_wine_bot@localhost:5432/read_wine_bot?sslmode=disable
